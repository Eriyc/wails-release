<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="authenticated-http-app"
        Arguments=""
        InstallLocation="C:\Program Files\wailsrel\Authenticated HTTP Example">
    </Installer>
    <PackageInformation
        PackageName="Authenticated HTTP Example"
        PackageDisplayName="Authenticated HTTP Example"
        PublisherName="CN=wailsrel"
        PublisherDisplayName="wailsrel"
        Version="0.1.0.0"
        PackageDescription="Wails updater example using an authenticated HTTP proxy">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.wailsrel.authenticatedhttpapp"
                Description="Wails updater example using an authenticated HTTP proxy"
                DisplayName="Authenticated HTTP Example"
                ExecutableName="authenticated-http-app"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Authenticated HTTP Example</DisplayName>
            <PublisherDisplayName>wailsrel</PublisherDisplayName>
            <Description>Wails updater example using an authenticated HTTP proxy</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="authenticated-http-app.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
