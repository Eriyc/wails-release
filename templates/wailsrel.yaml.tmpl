app:
  name: "{{ .AppName }}"
  identifier: "{{ .Identifier }}"
  description: "My Wails application"
  author: "Your Name"
  url: "https://example.com"

version:
  source: git
  file: ""
  tag_prefix: "v"
  prerelease_format: "beta.{n}"

targets:
  - os: darwin
    arch: [amd64, arm64]
    output_formats: [app, dmg]
    sign:
      provider: apple
      identity: "Developer ID Application: Example Inc (XXXXXXXXXX)"
      notarize: true
      apple_id: "${APPLE_ID}"
      password: "${APPLE_APP_PASSWORD}"
      team_id: "${APPLE_TEAM_ID}"

  - os: windows
    arch: [amd64]
    output_formats: [exe, nsis]
    sign:
      provider: azure
      endpoint: "${AZURE_ENDPOINT}"
      account: "${AZURE_CODE_SIGNING_NAME}"
      profile: "${AZURE_CERT_PROFILE}"

  - os: linux
    arch: [amd64]
    output_formats: [appimage, deb]
    sign:
      provider: none

installers:
  nsis:
    license: "LICENSE"
    icon: "build/windows/icon.ico"
    custom_script: ""
  dmg:
    background: "build/darwin/dmg-bg.png"
    icon_size: 80
    window_size: [600, 400]
  deb:
    depends: [libgtk-3-0, libwebkit2gtk-4.1-0]
    section: utils
    priority: optional

delta:
  enabled: true
  algorithm: bsdiff
  from_versions: 3
  old_artifacts:
    source: github-release
    repository: ""
    cache_dir: ".wailsrel/cache"
    manifest_url: ""
    auth_token_env: ""

frontend:
  enabled: true
  compat_version: 1
  compat_auto_check: true
  bindings_dir: "frontend/bindings"
  build_dir: "frontend/dist"
  channels: [stable, beta]
  build_command: "npm run build"

update:
  manifest_url: "https://releases.example.com/manifest.json"
  check_interval: "6h"
  channels: [stable, beta]
  allow_downgrade: false
  mandatory_min: ""

release:
  provider: github
  github:
    repository: ""
    api_base_url: "https://api.github.com"
  http:
    base_url: "https://releases.example.com"
    manifest_path: "/manifest.json"
    delta_manifest_path: "/delta/manifest.json"
    download_path_prefix: "/download"

output:
  dir: "dist"
  manifest_file: "manifest.json"
  clean: true

ci:
  provider: github
  timeout: "30m"
  artifacts:
    upload: true
    retention_days: 90
