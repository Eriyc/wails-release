schema: 2

app:
  name: "{{ .AppName }}"
  identifier: "{{ .Identifier }}"
  description: "My Wails application"
  author: "Your Name"
  url: "https://example.com"

version:
  source: git
  file: ""
  tag_prefix: "v"
  prerelease_format: "beta.{n}"

targets:
{{- if .HasDarwinTaskfile }}
  - id: darwin-arm64
    os: darwin
    arch: arm64
    build:
      argv: ["task", "-t", "build/darwin/Taskfile.yml", "package"]
      requires: ["task", "wails3"]
    artifacts:
      - format: app
        path: "bin/{{ .AppName }}.app"
      - format: dmg
        glob: "bin/*.dmg"
{{- end }}
{{- if .HasWindowsTaskfile }}
  - id: windows-amd64
    os: windows
    arch: amd64
    build:
      argv: ["task", "-t", "build/windows/Taskfile.yml", "create:nsis:installer", "ARCH={{"{{"}}arch{{"}}"}}"]
      requires: ["task", "wails3", "makensis"]
    artifacts:
      - format: exe
        path: "bin/{{ .AppName }}.exe"
      - format: nsis
        glob: "build/windows/nsis/*-installer.exe"
      - format: msix
        glob: "bin/*.msix"
        include_in_manifest: false
        enable_delta: false
{{- end }}
{{- if .HasLinuxTaskfile }}
  - id: linux-amd64
    os: linux
    arch: amd64
    build:
      argv: ["task", "-t", "build/linux/Taskfile.yml", "create:appimage"]
      requires: ["task", "wails3"]
    artifacts:
      - format: appimage
        glob: "bin/*.AppImage"
      - format: deb
        glob: "bin/*.deb"
      - format: rpm
        glob: "bin/*.rpm"
{{- end }}
{{- if not .HasDetectedTaskfiles }}
  - id: linux-amd64
    os: linux
    arch: amd64
    build:
      argv: ["task", "build"]
      requires: ["task", "wails3"]
    artifacts:
      - format: binary
        path: "bin/{{ .AppName }}"
{{- end }}

delta:
  enabled: true
  algorithm: bsdiff
  from_versions: 3
  old_artifacts:
    source: github-release
    repository: ""
    cache_dir: ".wailsrel/cache"
    manifest_url: ""
    auth_token_env: ""

frontend:
  enabled: true
  compat_version: 1
  compat_auto_check: true
  bindings_dir: "frontend/bindings"
  build_dir: "frontend/dist"
  channels: [stable, beta]
  build_command: "npm run build"

update:
  manifest_url: "https://releases.example.com/manifest.json"
  check_interval: "6h"
  channels: [stable, beta]
  allow_downgrade: false
  mandatory_min: ""

release:
  provider: github
  github:
    repository: ""
    api_base_url: "https://api.github.com"
  http:
    base_url: "https://releases.example.com"
    manifest_path: "/manifest.json"
    delta_manifest_path: "/delta/manifest.json"
    download_path_prefix: "/download"

output:
  dir: "dist"
  manifest_file: "manifest.json"
  clean: true

ci:
  provider: github
  timeout: "30m"
  artifacts:
    upload: true
    retention_days: 90
