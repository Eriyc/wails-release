{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wailsrel Public Release Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "app_name",
    "version",
    "channel",
    "date",
    "native_compat_id",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "app_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "release_notes": {
      "type": "string"
    },
    "native_compat_id": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "frontend_bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frontend_bundle"
      }
    },
    "mandatory": {
      "$ref": "#/$defs/mandatory"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "os",
        "arch",
        "format",
        "url",
        "checksum",
        "size"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "patch": {
      "type": "object",
      "required": [
        "from_version",
        "os",
        "arch",
        "from_hash",
        "to_hash",
        "url",
        "checksum",
        "size"
      ],
      "properties": {
        "from_version": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "from_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "to_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "frontend_bundle": {
      "type": "object",
      "required": [
        "channel",
        "version",
        "compat_id",
        "url",
        "checksum",
        "size"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "compat_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "mandatory": {
      "type": "object",
      "required": [
        "min_version",
        "message"
      ],
      "properties": {
        "min_version": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
