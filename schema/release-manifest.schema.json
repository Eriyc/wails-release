{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wailsrel Release Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "app",
    "release",
    "generated_at",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "app": {
      "type": "object",
      "required": ["name", "identifier"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["tag", "version", "provider"],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "enum": ["github", "http"]
        }
      },
      "additionalProperties": false
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "delta": {
      "type": "object",
      "required": ["manifest_url"],
      "properties": {
        "manifest_url": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "asset_name",
        "os",
        "arch",
        "format",
        "transport",
        "checksum",
        "size",
        "url",
        "metadata"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "asset_name": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "enum": ["file", "archive"]
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
