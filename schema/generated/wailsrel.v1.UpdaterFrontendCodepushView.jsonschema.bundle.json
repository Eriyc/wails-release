{
  "$defs": {
    "google.protobuf.Timestamp.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "wailsrel.v1.UpdaterFrontendCodepushView.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(compat_id)$": {
          "default": "",
          "type": "string"
        },
        "^(published_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        }
      },
      "properties": {
        "checksum": {
          "default": "",
          "type": "string"
        },
        "compatId": {
          "default": "",
          "type": "string"
        },
        "force": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "publishedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "url": {
          "default": "",
          "type": "string"
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Updater Frontend Codepush View",
      "type": "object"
    }
  },
  "$id": "wailsrel.v1.UpdaterFrontendCodepushView.jsonschema.bundle.json",
  "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendCodepushView.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
