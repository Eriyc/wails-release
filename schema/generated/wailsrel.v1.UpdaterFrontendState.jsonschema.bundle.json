{
  "$defs": {
    "google.protobuf.Timestamp.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "wailsrel.v1.UpdaterFrontendBundleView.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(commit_sha)$": {
          "default": "",
          "type": "string"
        },
        "^(compat_id)$": {
          "default": "",
          "type": "string"
        },
        "^(source_branch)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "channel": {
          "default": "",
          "type": "string"
        },
        "commitSha": {
          "default": "",
          "type": "string"
        },
        "compatId": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "sourceBranch": {
          "default": "",
          "type": "string"
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Updater Frontend Bundle View",
      "type": "object"
    },
    "wailsrel.v1.UpdaterFrontendCodepushView.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(compat_id)$": {
          "default": "",
          "type": "string"
        },
        "^(published_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        }
      },
      "properties": {
        "checksum": {
          "default": "",
          "type": "string"
        },
        "compatId": {
          "default": "",
          "type": "string"
        },
        "force": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "publishedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "url": {
          "default": "",
          "type": "string"
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Updater Frontend Codepush View",
      "type": "object"
    },
    "wailsrel.v1.UpdaterFrontendExperimentView.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(compat_id)$": {
          "default": "",
          "type": "string"
        },
        "^(display_name)$": {
          "default": "",
          "type": "string"
        },
        "^(published_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        }
      },
      "properties": {
        "checksum": {
          "default": "",
          "type": "string"
        },
        "compatId": {
          "default": "",
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "displayName": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "publishedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "url": {
          "default": "",
          "type": "string"
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Updater Frontend Experiment View",
      "type": "object"
    },
    "wailsrel.v1.UpdaterFrontendState.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(active_bundle)$": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendBundleView.jsonschema.json"
        },
        "^(active_mode)$": {
          "default": "",
          "type": "string"
        },
        "^(available_codepush)$": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendCodepushView.jsonschema.json"
        },
        "^(available_experiments)$": {
          "items": {
            "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendExperimentView.jsonschema.json"
          },
          "type": "array"
        },
        "^(catalog_url)$": {
          "default": "",
          "type": "string"
        },
        "^(installed_codepush)$": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendBundleView.jsonschema.json"
        },
        "^(installed_experiments)$": {
          "items": {
            "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendBundleView.jsonschema.json"
          },
          "type": "array"
        },
        "^(last_checked_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(last_error)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "activeBundle": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendBundleView.jsonschema.json"
        },
        "activeMode": {
          "default": "",
          "type": "string"
        },
        "availableCodepush": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendCodepushView.jsonschema.json"
        },
        "availableExperiments": {
          "items": {
            "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendExperimentView.jsonschema.json"
          },
          "type": "array"
        },
        "catalogUrl": {
          "default": "",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "installedCodepush": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendBundleView.jsonschema.json"
        },
        "installedExperiments": {
          "items": {
            "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendBundleView.jsonschema.json"
          },
          "type": "array"
        },
        "lastCheckedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "lastError": {
          "default": "",
          "type": "string"
        },
        "offline": {
          "default": false,
          "type": "boolean"
        },
        "selection": {
          "default": "",
          "type": "string"
        },
        "stale": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "Updater Frontend State",
      "type": "object"
    }
  },
  "$id": "wailsrel.v1.UpdaterFrontendState.jsonschema.bundle.json",
  "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendState.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
