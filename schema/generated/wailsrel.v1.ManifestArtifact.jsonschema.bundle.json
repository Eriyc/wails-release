{
  "$defs": {
    "wailsrel.v1.ManifestArtifact.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(asset_name)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "arch": {
          "default": "",
          "type": "string"
        },
        "assetName": {
          "default": "",
          "type": "string"
        },
        "checksum": {
          "default": "",
          "type": "string"
        },
        "format": {
          "default": "",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "os": {
          "default": "",
          "type": "string"
        },
        "path": {
          "default": "",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "transport": {
          "default": "",
          "type": "string"
        },
        "url": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Manifest Artifact",
      "type": "object"
    }
  },
  "$id": "wailsrel.v1.ManifestArtifact.jsonschema.bundle.json",
  "$ref": "#/$defs/wailsrel.v1.ManifestArtifact.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
