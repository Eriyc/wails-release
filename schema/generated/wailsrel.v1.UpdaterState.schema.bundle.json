{
  "$defs": {
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "wailsrel.v1.UpdaterState.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(availableUpdate)$": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterUpdateView.schema.json"
        },
        "^(currentHash)$": {
          "default": "",
          "type": "string"
        },
        "^(currentVersion)$": {
          "default": "",
          "type": "string"
        },
        "^(lastCheckedAt)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(lastError)$": {
          "default": "",
          "type": "string"
        },
        "^(manifestUrl)$": {
          "default": "",
          "type": "string"
        },
        "^(nativeCompat)$": {
          "default": "",
          "type": "string"
        },
        "^(pendingRestart)$": {
          "default": false,
          "type": "boolean"
        },
        "^(targetPath)$": {
          "default": "",
          "type": "string"
        },
        "^(tempDir)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "available_update": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterUpdateView.schema.json"
        },
        "channel": {
          "default": "",
          "type": "string"
        },
        "current_hash": {
          "default": "",
          "type": "string"
        },
        "current_version": {
          "default": "",
          "type": "string"
        },
        "last_checked_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "last_error": {
          "default": "",
          "type": "string"
        },
        "manifest_url": {
          "default": "",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "native_compat": {
          "default": "",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pending_restart": {
          "default": false,
          "type": "boolean"
        },
        "target_path": {
          "default": "",
          "type": "string"
        },
        "temp_dir": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Updater State",
      "type": "object"
    },
    "wailsrel.v1.UpdaterUpdateView.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(artifactHash)$": {
          "default": "",
          "type": "string"
        },
        "^(artifactSize)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(artifactUrl)$": {
          "default": "",
          "type": "string"
        },
        "^(deltaFromHash)$": {
          "default": "",
          "type": "string"
        },
        "^(deltaHash)$": {
          "default": "",
          "type": "string"
        },
        "^(deltaSize)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(deltaUrl)$": {
          "default": "",
          "type": "string"
        },
        "^(frontendHash)$": {
          "default": "",
          "type": "string"
        },
        "^(frontendOnly)$": {
          "default": false,
          "type": "boolean"
        },
        "^(frontendSize)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(frontendUrl)$": {
          "default": "",
          "type": "string"
        },
        "^(releaseNotes)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "artifact_hash": {
          "default": "",
          "type": "string"
        },
        "artifact_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "artifact_url": {
          "default": "",
          "type": "string"
        },
        "channel": {
          "default": "",
          "type": "string"
        },
        "delta_from_hash": {
          "default": "",
          "type": "string"
        },
        "delta_hash": {
          "default": "",
          "type": "string"
        },
        "delta_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "delta_url": {
          "default": "",
          "type": "string"
        },
        "frontend_hash": {
          "default": "",
          "type": "string"
        },
        "frontend_only": {
          "default": false,
          "type": "boolean"
        },
        "frontend_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "frontend_url": {
          "default": "",
          "type": "string"
        },
        "mandatory": {
          "default": false,
          "type": "boolean"
        },
        "release_notes": {
          "default": "",
          "type": "string"
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Updater Update View",
      "type": "object"
    }
  },
  "$id": "wailsrel.v1.UpdaterState.schema.bundle.json",
  "$ref": "#/$defs/wailsrel.v1.UpdaterState.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
