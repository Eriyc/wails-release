{
  "$id": "wailsrel.v1.UpdaterState.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "available_update": {
      "$ref": "wailsrel.v1.UpdaterUpdateView.schema.strict.json"
    },
    "channel": {
      "type": "string"
    },
    "current_hash": {
      "type": "string"
    },
    "current_version": {
      "type": "string"
    },
    "last_checked_at": {
      "$ref": "google.protobuf.Timestamp.schema.strict.json"
    },
    "last_error": {
      "type": "string"
    },
    "manifest_url": {
      "type": "string"
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "native_compat": {
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pending_restart": {
      "type": "boolean"
    },
    "target_path": {
      "type": "string"
    },
    "temp_dir": {
      "type": "string"
    }
  },
  "required": [
    "manifest_url",
    "current_version",
    "current_hash",
    "channel",
    "native_compat",
    "target_path",
    "temp_dir",
    "pending_restart",
    "last_error"
  ],
  "title": "Updater State",
  "type": "object"
}
