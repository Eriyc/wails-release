{
  "$defs": {
    "google.protobuf.Timestamp.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "wailsrel.v1.UpdaterFrontendBundleView.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "compat_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source_branch": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version",
        "compat_id",
        "channel",
        "source_branch",
        "commit_sha"
      ],
      "title": "Updater Frontend Bundle View",
      "type": "object"
    },
    "wailsrel.v1.UpdaterFrontendCodepushView.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "type": "string"
        },
        "compat_id": {
          "type": "string"
        },
        "force": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "published_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.strict.json"
        },
        "size": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "compat_id",
        "url",
        "checksum",
        "size",
        "force"
      ],
      "title": "Updater Frontend Codepush View",
      "type": "object"
    },
    "wailsrel.v1.UpdaterFrontendExperimentView.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "type": "string"
        },
        "compat_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "published_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.strict.json"
        },
        "size": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "compat_id",
        "url",
        "checksum",
        "size",
        "display_name",
        "description"
      ],
      "title": "Updater Frontend Experiment View",
      "type": "object"
    },
    "wailsrel.v1.UpdaterFrontendState.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "active_bundle": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendBundleView.schema.strict.json"
        },
        "active_mode": {
          "type": "string"
        },
        "available_codepush": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendCodepushView.schema.strict.json"
        },
        "available_experiments": {
          "items": {
            "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendExperimentView.schema.strict.json"
          },
          "type": "array"
        },
        "catalog_url": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "installed_codepush": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendBundleView.schema.strict.json"
        },
        "installed_experiments": {
          "items": {
            "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendBundleView.schema.strict.json"
          },
          "type": "array"
        },
        "last_checked_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.strict.json"
        },
        "last_error": {
          "type": "string"
        },
        "offline": {
          "type": "boolean"
        },
        "selection": {
          "type": "string"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "catalog_url",
        "last_error",
        "offline",
        "stale",
        "active_mode",
        "selection"
      ],
      "title": "Updater Frontend State",
      "type": "object"
    }
  },
  "$id": "wailsrel.v1.UpdaterFrontendState.schema.strict.bundle.json",
  "$ref": "#/$defs/wailsrel.v1.UpdaterFrontendState.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
