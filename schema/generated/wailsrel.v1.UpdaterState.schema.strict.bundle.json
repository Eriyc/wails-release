{
  "$defs": {
    "google.protobuf.Timestamp.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "wailsrel.v1.UpdaterState.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "available_update": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterUpdateView.schema.strict.json"
        },
        "channel": {
          "type": "string"
        },
        "current_hash": {
          "type": "string"
        },
        "current_version": {
          "type": "string"
        },
        "last_checked_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.strict.json"
        },
        "last_error": {
          "type": "string"
        },
        "manifest_url": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "native_compat": {
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pending_restart": {
          "type": "boolean"
        },
        "target_path": {
          "type": "string"
        },
        "temp_dir": {
          "type": "string"
        }
      },
      "required": [
        "manifest_url",
        "current_version",
        "current_hash",
        "channel",
        "native_compat",
        "target_path",
        "temp_dir",
        "pending_restart",
        "last_error"
      ],
      "title": "Updater State",
      "type": "object"
    },
    "wailsrel.v1.UpdaterUpdateView.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "artifact_hash": {
          "type": "string"
        },
        "artifact_size": {
          "type": "integer"
        },
        "artifact_url": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "delta_from_hash": {
          "type": "string"
        },
        "delta_hash": {
          "type": "string"
        },
        "delta_size": {
          "type": "integer"
        },
        "delta_url": {
          "type": "string"
        },
        "frontend_hash": {
          "type": "string"
        },
        "frontend_only": {
          "type": "boolean"
        },
        "frontend_size": {
          "type": "integer"
        },
        "frontend_url": {
          "type": "string"
        },
        "mandatory": {
          "type": "boolean"
        },
        "release_notes": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "channel",
        "release_notes",
        "mandatory",
        "artifact_url",
        "artifact_hash",
        "artifact_size",
        "delta_url",
        "delta_hash",
        "delta_size",
        "delta_from_hash",
        "frontend_url",
        "frontend_hash",
        "frontend_size",
        "frontend_only"
      ],
      "title": "Updater Update View",
      "type": "object"
    }
  },
  "$id": "wailsrel.v1.UpdaterState.schema.strict.bundle.json",
  "$ref": "#/$defs/wailsrel.v1.UpdaterState.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
