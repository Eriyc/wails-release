{
  "$defs": {
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "wailsrel.v1.PlatformAsset.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(assetKey)$": {
          "default": "",
          "type": "string"
        },
        "^(commitSha)$": {
          "default": "",
          "type": "string"
        },
        "^(compatId)$": {
          "default": "",
          "type": "string"
        },
        "^(logicalPath)$": {
          "default": "",
          "type": "string"
        },
        "^(publishedAt)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(sourceBranch)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "arch": {
          "default": "",
          "type": "string"
        },
        "asset_key": {
          "default": "",
          "type": "string"
        },
        "channel": {
          "default": "",
          "type": "string"
        },
        "checksum": {
          "default": "",
          "type": "string"
        },
        "commit_sha": {
          "default": "",
          "type": "string"
        },
        "compat_id": {
          "default": "",
          "type": "string"
        },
        "force": {
          "default": false,
          "type": "boolean"
        },
        "format": {
          "default": "",
          "type": "string"
        },
        "logical_path": {
          "default": "",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "os": {
          "default": "",
          "type": "string"
        },
        "published_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "source_branch": {
          "default": "",
          "type": "string"
        },
        "transport": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Platform Asset",
      "type": "object"
    }
  },
  "$id": "wailsrel.v1.PlatformAsset.schema.bundle.json",
  "$ref": "#/$defs/wailsrel.v1.PlatformAsset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
