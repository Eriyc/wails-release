{
  "$defs": {
    "google.protobuf.Timestamp.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "wailsrel.v1.UpdaterState.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(available_update)$": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterUpdateView.jsonschema.json"
        },
        "^(current_hash)$": {
          "default": "",
          "type": "string"
        },
        "^(current_version)$": {
          "default": "",
          "type": "string"
        },
        "^(last_checked_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(last_error)$": {
          "default": "",
          "type": "string"
        },
        "^(manifest_url)$": {
          "default": "",
          "type": "string"
        },
        "^(native_compat)$": {
          "default": "",
          "type": "string"
        },
        "^(pending_restart)$": {
          "default": false,
          "type": "boolean"
        },
        "^(target_path)$": {
          "default": "",
          "type": "string"
        },
        "^(temp_dir)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "availableUpdate": {
          "$ref": "#/$defs/wailsrel.v1.UpdaterUpdateView.jsonschema.json"
        },
        "channel": {
          "default": "",
          "type": "string"
        },
        "currentHash": {
          "default": "",
          "type": "string"
        },
        "currentVersion": {
          "default": "",
          "type": "string"
        },
        "lastCheckedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "lastError": {
          "default": "",
          "type": "string"
        },
        "manifestUrl": {
          "default": "",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "nativeCompat": {
          "default": "",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pendingRestart": {
          "default": false,
          "type": "boolean"
        },
        "targetPath": {
          "default": "",
          "type": "string"
        },
        "tempDir": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Updater State",
      "type": "object"
    },
    "wailsrel.v1.UpdaterUpdateView.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(artifact_hash)$": {
          "default": "",
          "type": "string"
        },
        "^(artifact_size)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(artifact_url)$": {
          "default": "",
          "type": "string"
        },
        "^(delta_from_hash)$": {
          "default": "",
          "type": "string"
        },
        "^(delta_hash)$": {
          "default": "",
          "type": "string"
        },
        "^(delta_size)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(delta_url)$": {
          "default": "",
          "type": "string"
        },
        "^(frontend_hash)$": {
          "default": "",
          "type": "string"
        },
        "^(frontend_only)$": {
          "default": false,
          "type": "boolean"
        },
        "^(frontend_size)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(frontend_url)$": {
          "default": "",
          "type": "string"
        },
        "^(release_notes)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "artifactHash": {
          "default": "",
          "type": "string"
        },
        "artifactSize": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "artifactUrl": {
          "default": "",
          "type": "string"
        },
        "channel": {
          "default": "",
          "type": "string"
        },
        "deltaFromHash": {
          "default": "",
          "type": "string"
        },
        "deltaHash": {
          "default": "",
          "type": "string"
        },
        "deltaSize": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "deltaUrl": {
          "default": "",
          "type": "string"
        },
        "frontendHash": {
          "default": "",
          "type": "string"
        },
        "frontendOnly": {
          "default": false,
          "type": "boolean"
        },
        "frontendSize": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "frontendUrl": {
          "default": "",
          "type": "string"
        },
        "mandatory": {
          "default": false,
          "type": "boolean"
        },
        "releaseNotes": {
          "default": "",
          "type": "string"
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Updater Update View",
      "type": "object"
    }
  },
  "$id": "wailsrel.v1.UpdaterState.jsonschema.bundle.json",
  "$ref": "#/$defs/wailsrel.v1.UpdaterState.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
