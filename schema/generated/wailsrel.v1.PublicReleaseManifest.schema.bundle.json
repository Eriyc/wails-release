{
  "$defs": {
    "google.protobuf.Timestamp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "wailsrel.v1.BundleEntry.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(assetKey)$": {
          "default": "",
          "type": "string"
        },
        "^(commitSha)$": {
          "default": "",
          "type": "string"
        },
        "^(compatId)$": {
          "default": "",
          "type": "string"
        },
        "^(displayName)$": {
          "default": "",
          "type": "string"
        },
        "^(publishedAt)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(sourceBranch)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "asset_key": {
          "default": "",
          "type": "string"
        },
        "channel": {
          "default": "",
          "type": "string"
        },
        "checksum": {
          "default": "",
          "type": "string"
        },
        "commit_sha": {
          "default": "",
          "type": "string"
        },
        "compat_id": {
          "default": "",
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "display_name": {
          "default": "",
          "type": "string"
        },
        "force": {
          "default": false,
          "type": "boolean"
        },
        "kind": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "published_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "source_branch": {
          "default": "",
          "type": "string"
        },
        "tag": {
          "default": "",
          "type": "string"
        },
        "url": {
          "default": "",
          "type": "string"
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Bundle Entry",
      "type": "object"
    },
    "wailsrel.v1.ManifestApp.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Manifest App",
      "type": "object"
    },
    "wailsrel.v1.ManifestArtifact.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(assetName)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "arch": {
          "default": "",
          "type": "string"
        },
        "asset_name": {
          "default": "",
          "type": "string"
        },
        "checksum": {
          "default": "",
          "type": "string"
        },
        "format": {
          "default": "",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "os": {
          "default": "",
          "type": "string"
        },
        "path": {
          "default": "",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "transport": {
          "default": "",
          "type": "string"
        },
        "url": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Manifest Artifact",
      "type": "object"
    },
    "wailsrel.v1.ManifestDelta.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(manifestUrl)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "manifest_url": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Manifest Delta",
      "type": "object"
    },
    "wailsrel.v1.ManifestRelease.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "",
          "type": "string"
        },
        "tag": {
          "default": "",
          "type": "string"
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Manifest Release",
      "type": "object"
    },
    "wailsrel.v1.PublicReleaseManifest.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(frontendBundles)$": {
          "items": {
            "$ref": "#/$defs/wailsrel.v1.BundleEntry.schema.json"
          },
          "type": "array"
        },
        "^(generatedAt)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "^(schemaVersion)$": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "properties": {
        "app": {
          "$ref": "#/$defs/wailsrel.v1.ManifestApp.schema.json"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/wailsrel.v1.ManifestArtifact.schema.json"
          },
          "type": "array"
        },
        "delta": {
          "$ref": "#/$defs/wailsrel.v1.ManifestDelta.schema.json"
        },
        "frontend_bundles": {
          "items": {
            "$ref": "#/$defs/wailsrel.v1.BundleEntry.schema.json"
          },
          "type": "array"
        },
        "generated_at": {
          "$ref": "#/$defs/google.protobuf.Timestamp.schema.json"
        },
        "release": {
          "$ref": "#/$defs/wailsrel.v1.ManifestRelease.schema.json"
        },
        "schema_version": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Public Release Manifest",
      "type": "object"
    }
  },
  "$id": "wailsrel.v1.PublicReleaseManifest.schema.bundle.json",
  "$ref": "#/$defs/wailsrel.v1.PublicReleaseManifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
